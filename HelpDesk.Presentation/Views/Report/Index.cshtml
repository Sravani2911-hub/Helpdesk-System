@model HelpDesk.Presentation.Models.ReportViewModel

@{
    ViewData["Title"] = "Reports";
}

<div class="container-fluid mt-4">

    <div class="mb-4">

        <h2 class="fw-bold">
            <i class="bi bi-bar-chart-line-fill text-primary"></i>
            Reports Dashboard
        </h2>

        <p class="text-muted">
            View overall HelpDesk ticket statistics.
        </p>



        <form method="get" class="row g-3 mb-4">

            <div class="col-md-3">

                <label class="form-label fw-semibold">

                    From Date

                </label>

                <input type="date"
                       class="form-control"
                       name="fromDate"
                       value="@Model.FromDate?.ToString("yyyy-MM-dd")" />

            </div>

            <div class="col-md-3">

                <label class="form-label fw-semibold">

                    To Date

                </label>

                <input type="date"
                       class="form-control"
                       name="toDate"
                       value="@Model.ToDate?.ToString("yyyy-MM-dd")" />

            </div>

            <div class="col-md-3">

                <label class="form-label fw-semibold">

                    Status

                </label>

                <select class="form-select" name="status">

                    <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">
                        All
                    </option>

                    <option value="Open" selected="@(Model.Status == "Open")">
                        Open
                    </option>

                    <option value="In Progress" selected="@(Model.Status == "In Progress")">
                        In Progress
                    </option>

                    <option value="Resolved" selected="@(Model.Status == "Resolved")">
                        Resolved
                    </option>

                    <option value="Closed" selected="@(Model.Status == "Closed")">
                        Closed
                    </option>

                </select>

            </div>

            <div class="col-md-3 d-flex align-items-end">

                <button class="btn btn-primary w-100">

                    <i class="bi bi-funnel-fill"></i>

                    Apply Filter

                </button>

            </div>

        </form>



    </div>

    <div class="row">

        <div class="col-lg-3 col-md-6 mb-4">

            <div class="card stat-card gradient-blue h-100">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>

                        <h6>Total Tickets</h6>

                        <h2 class="card-number">
                            @Model.TotalTickets
                        </h2>

                    </div>

                    <i class="bi bi-ticket-detailed-fill card-icon"></i>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6 mb-4">

            <div class="card stat-card gradient-orange h-100">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>

                        <h6>Open Tickets</h6>

                        <h2 class="card-number">
                            @Model.OpenTickets
                        </h2>

                    </div>

                    <i class="bi bi-folder2-open card-icon"></i>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6 mb-4">

            <div class="card stat-card gradient-purple h-100">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>

                        <h6>In Progress</h6>

                        <h2 class="card-number">
                            @Model.InProgressTickets
                        </h2>

                    </div>

                    <i class="bi bi-arrow-repeat card-icon"></i>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6 mb-4">

            <div class="card stat-card gradient-green h-100">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>

                        <h6>Resolved</h6>

                        <h2 class="card-number">
                            @Model.ResolvedTickets
                        </h2>

                    </div>

                    <i class="bi bi-check-circle-fill card-icon"></i>

                </div>

            </div>

        </div>

    </div>

    <div class="row">

        <div class="col-lg-3 col-md-6">

            <div class="card stat-card gradient-dark h-100">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>

                        <h6>Closed Tickets</h6>

                        <h2 class="card-number">
                            @Model.ClosedTickets
                        </h2>

                    </div>

                    <i class="bi bi-lock-fill card-icon"></i>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow mt-4">

        <div class="card-header bg-dark text-white">

            <h4 class="mb-0">
                <i class="bi bi-table"></i>
                Filtered Tickets
            </h4>

        </div>

        <div class="card-body">

            <table class="table table-hover">

                <thead class="table-light">

                    <tr>

                        <th>Ticket No</th>
                        <th>Title</th> 
                        <th>Department</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Created</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var ticket in Model.Tickets)
                    {
                        <tr>

                            <td>@ticket.TicketNumber</td>

                            <td>@ticket.Title</td>

                            <td>@ticket.Department?.DepartmentName</td>

                            <td>@ticket.Priority?.PriorityName</td>

                            <td>@ticket.Status</td>

                            <td>@ticket.CreatedDate.ToString("dd-MMM-yyyy")</td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <div class="mb-4">

            <a asp-action="ExportToExcel"
               class="btn btn-success">

                <i class="bi bi-file-earmark-excel-fill"></i>

                Export to Excel

            </a>

        </div>


    </div>

</div>