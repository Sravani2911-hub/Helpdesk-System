<!--Without this line, Razor cannot understand Identity-related classes.-->
@using Microsoft.AspNetCore.Identity

@inject SignInManager<HelpDesk.DAL.Models.ApplicationUser> SignInManager
@inject UserManager<HelpDesk.DAL.Models.ApplicationUser> UserManager  //Identity user roles

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HelpDesk.Presentation</title>

    <!--Loads Bootstrap framework.like Buttons, Cards,Navbar,Grid system ,forms etc-->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!--Loads icon library.-->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ticket.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employee.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HelpDesk.Presentation.styles.css" asp-append-version="true" />

</head>

<body>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>  <!--Loads Chart.js library. eg:Ticket statistics,pending tickets graph,resloved tickets graph-->
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {

        <!-- Sidebar -->

        <div class="sidebar">

            <div class="logo">
                <i class="bi bi-tools"></i> HelpDesk Pro
            </div> <!--bi-tools : comes from boostrap icons -->
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Dashboard" asp-action="Index">
                    <!--Creates: /Dashboard/Index-->
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <a asp-controller="Ticket" asp-action="Index">
                    <i class="bi bi-ticket-detailed"></i> Tickets
                </a>

                <a asp-controller="Department" asp-action="Index">
                    <i class="bi bi-building"></i> Departments
                </a>

                <a asp-controller="Category" asp-action="Index">
                    <i class="bi bi-folder"></i> Categories
                </a>

                <a asp-controller="Priority" asp-action="Index">
                    <i class="bi bi-flag"></i> Priorities
                </a>
                <a asp-controller="User" asp-action="Index">
                    <i class="bi bi-people-fill"></i> User Management
                </a>
                <a asp-controller="Report" asp-action="Index">
                    <i class="bi bi-bar-chart-line"></i> Reports
                </a>

            }

            else if (User.IsInRole("Support Engineer"))
            {
                <a asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <a asp-controller="Ticket" asp-action="MyAssignedTickets">
                    <i class="bi bi-list-check"></i> My Assigned Tickets
                </a>

               
            }

            else if (User.IsInRole("Employee"))
            {
                <a asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <a asp-controller="Ticket" asp-action="Create">
                    <i class="bi bi-plus-circle"></i> Raise Ticket
                </a>

                <a asp-controller="Ticket" asp-action="MyTickets">
                    <i class="bi bi-ticket"></i> My Tickets
                </a>

            }

        </div>

        <!-- Top Navbar - creates top navigation bar -->

        <nav class="navbar navbar-expand-lg shadow-sm"
             style="margin-left:250px;
            background:#1f2937;
            border-bottom:1px solid #334155;">

            <div class="container-fluid d-flex align-items-center">

                <form asp-controller="Ticket"
                      asp-action="Index"
                      method="get"
                      class="d-flex me-2">

                    <div class="position-relative">

                        <i class="bi bi-search position-absolute"
                           style="left:15px;
                        top:50%;
                        transform:translateY(-50%);
                        color:#6c757d;"></i>

                        <input type="text"
                               name="searchText"
                               value="@Context.Request.Query["searchText"]"
                               class="form-control rounded-pill ps-5"
                               style="width:520px;"
                               placeholder="Search Ticket Number or Title..." />

                    </div>

                </form>
                <div class="flex-grow-1"></div>

                @await Component.InvokeAsync("Notification")


                <div class="dropdown ms-3 me-3">

                    
                  @*   <a class="dropdown-toggle text-decoration-none border rounded-pill px-3 py-2 d-flex align-items-center"
                       style="min-width:230px;border-color:#0d6efd;color:white;"
                       data-bs-toggle="dropdown"> *@
                    <a href="#"
                       class="dropdown-toggle text-decoration-none border rounded-pill px-3 py-2 d-flex align-items-center"
                       style="min-width:230px;border-color:#0d6efd;color:white;"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">

                        <div class="ms-2 text-start" style="line-height:1.15;">

                            <div class="fw-bold" style="font-size:15px;">
                                <i class="bi bi-person-circle"></i>
                                <!--Gets logged-in user's details from database.-->
                                @{
                                    var currentUser = await UserManager.GetUserAsync(User);
                                }

                                @(currentUser?.FullName ?? User.Identity?.Name)
                            </div>

                            <small class="text-white-50" style="font-size:11px;">
                                @{

                                    var roles = currentUser != null
                                      ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
                                }

                                @(roles.FirstOrDefault() ?? "User")
                            </small>

                        </div>

                    </a>

                    <ul class="dropdown-menu dropdown-menu-end">

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Dashboard"
                               asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Notification"
                               asp-action="Index">
                                <i class="bi bi-bell"></i>
                                Notifications
                            </a>
                        </li>

                        <li>

                            <a class="dropdown-item"
                               asp-controller="Profile"
                               asp-action="Index">

                                <i class="bi bi-person"></i>

                                My Profile

                            </a>

                        </li>

                    </ul>

                </div> 

              

                <!--using post request - calls Accountcontroller / logout -->
                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    <button class="btn btn-danger rounded-pill px-4">
                        Logout
                    </button>

                </form>
            </div>

                
        </nav>
        <!--imp - RenderBody() is replaced by current page content.like when opening: Ticket/Index,MVc inserts : Ticket Index.cshtml(here)-->
        <div class="main-content">

            @RenderBody()

        </div>

        <footer class="footer border-top text-muted">

            <div class="container-fluid">

                &copy; 2026 - HelpDesk.Presentation

            </div>

        </footer>

    }

    else
    {

        <main>

            @RenderBody()

        </main>

    }
    <!--Loads jQuery.Used by Bootstrap and validations.-->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!--Enables:Dropdowns,Modals,Navbar actions-->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!--Your application JavaScript.-->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!--Allows individual pages to add JavaScript.-->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>