@model IEnumerable<HelpDesk.DAL.Models.Notification>

<div class="dropdown me-2">
    <a class="btn btn-outline-light rounded-circle position-relative"
       style="width:42px;height:42px;"
       href="#"
       data-bs-toggle="dropdown">

        <i class="bi bi-bell-fill"></i>

        @if (ViewBag.UnreadCount > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">

                @ViewBag.UnreadCount

            </span>
        }

    </a>

    <ul class="dropdown-menu dropdown-menu-end shadow notification-dropdown">

        <li class="dropdown-header fw-bold fs-6">

            <i class="bi bi-bell-fill text-warning"></i>

            Notifications

        </li>

        <li><hr class="dropdown-divider" /></li>

        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <li>

                  @*   <a class="dropdown-item py-3"
                       asp-controller="Notification"
                       asp-action="Index"> *@
                    <a class="dropdown-item py-3 @(item.IsRead ? "" : "notification-unread")"
                       asp-controller="Notification"
                       asp-action="MarkAsRead"
                       asp-route-id="@item.NotificationId">

                        <div class="d-flex">

                            <div class="me-3">

                                @if (item.IsRead)
                                {
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                }
                                else
                                {
                                    <i class="bi bi-bell-fill text-danger fs-5"></i>
                                }

                            </div>

                            <div class="flex-grow-1">

                             @*    <div class="fw-semibold text-dark">
                                    @item.Message
                                </div> *@

                                <div class="fw-semibold @(item.IsRead ? "text-secondary" : "text-dark")">
                                    @item.Message
                                </div>

                                <small class="text-secondary">

                                    @item.CreatedDate.ToString("dd-MMM-yyyy hh:mm tt")

                                </small>

                            </div>

                        </div>

                    </a>

                </li>
            }

            <li><hr class="dropdown-divider" /></li>

            <li>

                <a asp-controller="Notification"
                   asp-action="Index"
                   class="dropdown-item text-center fw-bold text-primary">

                    View All Notifications →

                </a>

            </li>
        }
        else
        {
            <li class="dropdown-item text-center py-4">

                <i class="bi bi-bell-slash fs-3 text-muted"></i>

                <br />

                No Notifications

            </li>
        }
    </ul>
</div>

<style>
    .notification-unread {
        background-color: #f0f7ff;
        border-left: 3px solid #0d6efd;
    }

        .notification-unread:hover {
            background-color: #e2efff;
        }
</style>