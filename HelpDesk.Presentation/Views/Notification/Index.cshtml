@model IEnumerable<HelpDesk.DAL.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
}

<div class="container mt-4 notification-page">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                <i class="bi bi-bell-fill text-warning"></i>
                Notifications
            </h2>

            <p class="text-muted mb-0">
                Stay updated with your latest HelpDesk activities.
            </p>

        </div>

        <span class="badge bg-primary fs-6 px-3 py-2">

            Total : @Model.Count()

        </span>

    </div>

    @if (Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="card shadow-sm notification-card mb-3">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div class="d-flex">

                            <div class="notification-icon">

                                @if (item.IsRead)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                                else
                                {
                                    <i class="bi bi-bell-fill text-danger"></i>
                                }

                            </div>

                            <div class="ms-3">
                                <div class="notification-message">

                                    @item.Message

                                </div>

                                <small class="text-muted">

                                    <i class="bi bi-clock"></i>

                                    @item.CreatedDate.ToString("dd-MMM-yyyy hh:mm tt")

                                </small>

                            </div>

                        </div>

                        <div>

                            @if (!item.IsRead)
                            {
                                <a asp-action="MarkAsRead"
                                   asp-route-id="@item.NotificationId"
                                   class="btn btn-success btn-sm">

                                    <i class="bi bi-check2-circle"></i>

                                    Mark as Read

                                </a>
                            }
                            else
                            {
                                <span class="badge bg-success">

                                    Read

                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }
    }
    else
    {
        <div class="alert alert-info">

            <i class="bi bi-info-circle-fill"></i>

            No notifications available.

        </div>
    }

</div>