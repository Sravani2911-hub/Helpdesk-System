@model HelpDesk.DAL.Models.Priority

@{
    ViewData["Title"] = "Edit Priority";
}

<h2>Edit Priority</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="PriorityId" />

    <div class="mb-3">
        <label asp-for="PriorityName" class="form-label"></label>

        <input asp-for="PriorityName" class="form-control" />

        <span asp-validation-for="PriorityName" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">

        <input asp-for="IsActive" class="form-check-input" />

        <label asp-for="IsActive" class="form-check-label"></label>

    </div>

    <button type="submit" class="btn btn-primary">
        Update
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}