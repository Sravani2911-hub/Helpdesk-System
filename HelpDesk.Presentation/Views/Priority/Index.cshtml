@model IEnumerable<HelpDesk.DAL.Models.Priority>

@{
    ViewData["Title"] = "Priorities";
}

<div class="ticket-page">

    <h2>Priorities</h2>
<form asp-action="Index" method="get" class="mb-3">

    <div class="row">

        <div class="col-md-4">

            <input type="text"
                   name="searchText"
                   value="@ViewBag.SearchText"
                   class="form-control"
                   placeholder="Search Priority" />

        </div>

        <div class="col-md-3">

            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Clear
            </a>

        </div>

    </div>

</form>

<p>
    <a asp-action="Create" class="btn btn-success">
        Create New Priority
    </a>
</p>

<table class="table table-bordered table-striped">

    <thead>

        <tr>
            <th>Priority Id</th>
            <th>Priority Name</th>
            <th>Is Active</th>
            <th>Actions</th>
        </tr>

    </thead>

    <tbody>

        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>

                    <td>@item.PriorityId</td>

                    <td>@item.PriorityName</td>

                    <td>@item.IsActive</td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@item.PriorityId"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.PriorityId"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </td>

                </tr>
            }
        }
        else
        {
            <tr>

                <td colspan="4" class="text-center">
                    No Priorities Found
                </td>

            </tr>
        }

    </tbody>

</table>
</div>