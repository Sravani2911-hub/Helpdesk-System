@model HelpDesk.DAL.Models.Priority

@{
    ViewData["Title"] = "Delete Priority";
}

<h2>Delete Priority</h2>

<h4>Are you sure you want to delete this priority?</h4>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Priority Name
    </dt>

    <dd class="col-sm-9">
        @Model.PriorityName
    </dd>

    <dt class="col-sm-3">
        Is Active
    </dt>

    <dd class="col-sm-9">
        @Model.IsActive
    </dd>

</dl>

<form asp-action="DeleteConfirmed" method="post">

    <input type="hidden" asp-for="PriorityId" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>