@model HelpDesk.DAL.Models.Ticket

@{
    ViewData["Title"] = "Raise Support Ticket";
}
<div class="ticket-page">

<div class="container mt-4 ">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">


            <h3>
                🎫 Edit Support Ticket
            </h3>

            <p>Ticket Number: @Model.TicketNumber</p>

        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="TicketId" />

                <input type="hidden" asp-for="TicketNumber" />
               
                <input type="hidden" asp-for="CreatedDate" />

                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Department
                        </label>

                        <select asp-for="DepartmentId"
                                asp-items="ViewBag.Departments"
                                class="form-select" disabled>

                            <option value="">-- Select Department --</option>

                        </select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Category
                        </label>

                        <select asp-for="CategoryId"
                                asp-items="ViewBag.Categories"
                                class="form-select">

                            <option value="">-- Select Category --</option>

                        </select>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Priority
                        </label>

                        <select asp-for="PriorityId"
                                asp-items="ViewBag.Priorities"
                                class="form-select">

                            <option value="">-- Select Priority --</option>

                        </select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Title"></label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Enter Issue Title" readonly/>

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="Description"></label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="6"
                              placeholder="Describe your issue clearly..."  readonly></textarea>

                </div>

                <div class="mb-3">

                    <label class="form-label">Status</label>

                        @if (Model.Status == "Closed")
                        {
                            <select asp-for="Status"
                                    class="form-select"
                                    disabled>

                                <option>Closed</option>

                            </select>

                            <input type="hidden" asp-for="Status" />
                        }
                        else
                        {
                            <select asp-for="Status" class="form-select">

                                <option value="Open">Open</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Resolved">Resolved</option>
                                <option value="Closed">Closed</option>

                            </select>
                        }

                </div> 


                    @if (User.IsInRole("Admin"))
                    {
                        <div class="mb-3">

                            <label class="form-label">
                                Assign Support Engineer
                            </label>

                            <select asp-for="AssignedToId"
                                    asp-items="ViewBag.SupportEngineers"
                                    class="form-select">

                                <option value="">-- Select Support Engineer --</option>

                            </select>

                        </div>
                    }


                <div class="text-end">

                        @if (Model.Status == "Closed")
                        {
                            <button class="btn btn-secondary"
                                    disabled>

                                <i class="bi bi-lock-fill"></i>

                                Ticket Closed

                            </button>
                        }
                        else
                        {
                            <button class="btn btn-success">

                                Update Ticket

                            </button>
                        }

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
</div>