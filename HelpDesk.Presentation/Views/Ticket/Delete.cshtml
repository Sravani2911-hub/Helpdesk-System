@model HelpDesk.DAL.Models.Ticket

@{
    ViewData["Title"] = "Delete Ticket";
}

<div class="container mt-4">

    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">

            <h3>🗑 Delete Support Ticket</h3>

        </div>

        <div class="card-body">

            <h5 class="text-danger">
                Are you sure you want to delete this ticket?
            </h5>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">Ticket Number</dt>
                <dd class="col-sm-9">@Model.TicketNumber</dd>

                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">Department</dt>
                <dd class="col-sm-9">@Model.Department?.DepartmentName</dd>

                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">@Model.Category?.CategoryName</dd>

                <dt class="col-sm-3">Priority</dt>
                <dd class="col-sm-9">@Model.Priority?.PriorityName</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

            </dl>

            <form asp-action="Delete">

                <input type="hidden" asp-for="TicketId" />

                <button type="submit" class="btn btn-danger">
                    Delete Ticket
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>