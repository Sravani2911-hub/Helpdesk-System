@model IEnumerable<HelpDesk.DAL.Models.Ticket>

@{
    ViewData["Title"] = "Support Tickets";
}
<div class="ticket-page">

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Support Tickets</h2>

        <a asp-action="Create" class="btn btn-success">
            + Raise New Ticket
        </a>

    </div>

    <form method="get" class="row mb-3">

        <div class="col-md-4">

            <input type="text"
                   name="searchText"
                   value="@ViewBag.SearchText"
                   class="form-control" 
                   placeholder="Search by Ticket No or Title" />

        </div>

        <div class="col-md-2">

            <button class="btn btn-primary">
                Search
            </button>

        </div>
           
    </form>

    <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Ticket No</th>
                    <th>Title</th>
                    <th>Department</th>
                    <th>Category</th>
                 @*    <th>Priority</th> *@
                  @*   <th>Status</th>
                    <th>Assigned To</th> *@
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@item.TicketId"
                               class="text-decoration-none fw-semibold text-primary">
                                @item.TicketNumber
                            </a>
                        </td>

                        <td>@item.Title</td>

                        <td>@item.Department?.DepartmentName</td>

                        <td>@item.Category?.CategoryName</td>

                       @*  <td>@item.Priority?.PriorityName</td> *@

                       @*  <td>
                            @item.Status
                        </td>

                        <td>
                            @(item.AssignedTo?.FullName ?? "Not Assigned")
                        </td> *@

                        <td>

                           @*  <a asp-action="Details"
                               asp-route-id="@item.TicketId"
                               class="btn btn-info btn-sm">

                                <i class="bi bi-eye"></i>

                            </a> *@

                            @if (item.Status == "Closed")
                            {
                                <button class="btn btn-secondary btn-sm"
                                        disabled
                                        title="This ticket is closed and cannot be edited">

                                    <i class="bi bi-lock-fill"></i>Locked

                                </button>
                            }
                            else
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.TicketId"
                                   class="btn btn-warning btn-sm"
                                   title="Edit Ticket">

                                    <i class="bi bi-pencil"></i>

                                </a>
                            }

                        </td>

                    </tr>
                }

            </tbody>

    </table>

</div>
</div>